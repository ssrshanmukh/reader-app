{
 "name": "Side-by-side Reader",
 "short_name": "Reader",
 "id": "./",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#161616",
 "theme_color": "#176fc1",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "zips",
     "accept": [
      "application/zip",
      "application/x-zip-compressed",
      "application/octet-stream",
      ".zip"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/zip": [
     ".zip"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "navigate-existing"
 }
}